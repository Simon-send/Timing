{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "jest --runInBand __tests__",
    "test:rules": "jest --runInBand --testMatch \"**/rules-tests/**/*.test.js\"",
    "verify:rules": "firebase --config ../firebase.test.json --project demo-eq-results emulators:exec --only firestore \"npm run test:rules\"",
    "verify:deploy": "npm run lint && npm test && npm audit --omit=dev --audit-level=high",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "cleanup:legacy": "node scripts/cleanup-legacy-results.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/tasks": "^6.3.0",
    "axios": "^1.20.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "jest": "^29.7.0"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
